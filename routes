const express = require('express');
const router = express.Router();
const multer = require('multer');
const path = require('path');
const Sermon = require('../models/Sermon');

// Configure Multer storage to save audio files locally
const storage = multer.diskStorage({
  destination: function (req, file, cb) {
    cb(null, 'uploads/'); // Ensure an 'uploads' folder exists in your root directory
  },
  filename: function (req, file, cb) {
    cb(null, Date.now() + path.extname(file.originalname));
  }
});

const upload = multer({ 
  storage: storage,
  fileFilter: (req, file, cb) => {
    if (file.mimetype.startsWith('audio/')) {
      cb(null, true);
    } else {
      cb(new Error('Only audio files are allowed!'), false);
    }
  }
});

// 1. POST Route: Pastors upload a new sermon audio
router.post('/upload', upload.single('audio'), async (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'Please upload an audio file.' });
    }

    const { title, speaker, series, notes } = req.body;
    
    // Generate the path where the file can be accessed publicly
    const audioUrl = `/uploads/${req.file.filename}`;

    const newSermon = new Sermon({
      title,
      speaker,
      series,
      notes,
      audioUrl
    });

    await newSermon.save();
    res.status(201).json({ message: 'Sermon uploaded successfully!', sermon: newSermon });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// 2. GET Route: Fetch all sermons for users / Flutter app
router.get('/', async (req, res) => {
  try {
    const sermons = await Sermon.find().sort({ date: -1 });
    res.status(200).json(sermons);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

module.exports = router;